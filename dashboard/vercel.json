{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "node --check agu-hrrr/site/app.js && node --check agu-hrrr/site/theme.js && node --check agu-hrrr/site/story.js",
  "outputDirectory": "agu-hrrr/site",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/study",
      "destination": "https://github.com/Mitchel34/hydra-nwm-streamflow-correction/tree/agu-hrrr-2026",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
